---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Toolbar from '../components/Toolbar.astro';
import Preview from '../components/Preview.astro';
import EmojiDialog from '../components/EmojiDialog.astro';
import { TEMPLATES } from '../lib/templates.ts';
import { FAQ } from '../lib/faq.ts';
---

<Base>
  <a class="skip" href="#editor">Skip to editor</a>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <span class="brand-mark" aria-hidden="true"><Icon name="type" size={18} /></span>
        <span>LinkedIn Formatter</span>
      </a>
      <nav class="topnav" aria-label="Site">
        <a href="#templates">Templates</a>
        <a href="#faq">FAQ</a>
        <a class="icon-btn" href="https://github.com/ShubhamTatvamasi/LinkedIn-Formatter" aria-label="Source on GitHub" rel="noopener"><Icon name="github" /></a>
        <button type="button" class="icon-btn" id="themeBtn" aria-label="Toggle dark mode">
          <Icon name="moon" class="theme-moon" /><Icon name="sun" class="theme-sun" />
        </button>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <h1>Format LinkedIn posts that get read.</h1>
      <p>Bold, italic, lists and emojis that survive copy-paste, plus a live feed preview that shows exactly where <em>“…more”</em> cuts your hook. Free, private, no sign-up.</p>
    </section>

    <section class="workspace wrap" aria-label="Editor">
      <div class="editor-card">
        <Toolbar />
        <label for="editor" class="sr-only">Post text</label>
        <textarea
          id="editor"
          spellcheck="true"
          placeholder={'Write your post, or paste from ChatGPT, Google Docs or Word.\n\nSelect text, then hit Ctrl+B for bold.'}
        ></textarea>
        <div class="editor-foot">
          <div class="stats" aria-live="polite">
            <span class="stat stat-chars" id="charStat"><b id="charCount">0</b>/3,000</span>
            <span class="stat"><b id="wordCount">0</b> words</span>
            <span class="stat"><b id="readTime">0s</b> read</span>
            <span class="stat stat-paste" title="Rich text and Markdown are converted automatically when you paste"><Icon name="wand-sparkles" size={14} /> Smart paste on</span>
          </div>
          <button type="button" class="ghost-btn" id="clearBtn"><Icon name="trash-2" size={15} /> Clear</button>
        </div>
        <div class="meter" aria-hidden="true"><span id="meterFill"></span></div>
        <p class="a11y-hint" id="a11yHint" hidden>
          <Icon name="info" size={14} /> Lots of styled text. Screen readers may spell it out letter by letter, so keep styling for the hook and key phrases.
        </p>
      </div>

      <Preview />
    </section>

    <section class="templates wrap" id="templates" aria-labelledby="tpl-title">
      <div class="section-head">
        <h2 id="tpl-title">Start from a template</h2>
        <p>Proven post structures. Replace the [brackets] with your own words.</p>
      </div>
      <div class="tpl-grid">
        {TEMPLATES.map((t) => (
          <button type="button" class="tpl" data-template={t.id}>
            <span class="tpl-icon"><Icon name={t.icon} size={18} /></span>
            <span class="tpl-label">{t.label}</span>
            <span class="tpl-peek">{t.body.split('\n')[0]}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="how wrap" aria-labelledby="how-title">
      <h2 id="how-title" class="sr-only">How it works</h2>
      <ol class="steps">
        <li><span class="step-n">1</span><div><h3>Write or paste</h3><p>Type, or paste from ChatGPT, Docs or Word. Formatting converts automatically.</p></div></li>
        <li><span class="step-n">2</span><div><h3>Style the moments that matter</h3><p>Select a phrase and press <kbd>Ctrl</kbd>+<kbd>B</kbd>. Press again to undo the style.</p></div></li>
        <li><span class="step-n">3</span><div><h3>Check the fold, then copy</h3><p>Toggle desktop and mobile to see where “…more” lands, then copy into LinkedIn.</p></div></li>
      </ol>
    </section>

    <section class="faq wrap" id="faq" aria-labelledby="faq-title">
      <div class="section-head">
        <h2 id="faq-title">Questions</h2>
      </div>
      <div class="faq-list">
        {FAQ.map(({ q, a }) => (
          <details>
            <summary>{q}<Icon name="plus" size={16} class="faq-plus" /></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="footer wrap">
    <p>Made by <a href="https://shubhamtatvamasi.com/">Shubham Tatvamasi</a> · <a href="https://github.com/ShubhamTatvamasi/LinkedIn-Formatter">Open source (MIT)</a></p>
    <p class="muted">Not affiliated with or endorsed by LinkedIn Corporation.</p>
  </footer>

  <EmojiDialog />

  <dialog id="confirmDialog" class="dialog dialog-sm" aria-labelledby="confirm-title">
    <h2 id="confirm-title">Clear the editor?</h2>
    <p>This removes your current draft. You can still undo it.</p>
    <form method="dialog" class="dialog-actions">
      <button class="btn" value="cancel">Cancel</button>
      <button class="btn btn-danger" value="confirm">Clear</button>
    </form>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    import '../scripts/app.ts';
  </script>
</Base>
