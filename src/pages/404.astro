---
import Base from '../layouts/Base.astro';
const home = import.meta.env.BASE_URL;
---

<Base title="Page not found · LinkedIn Formatter" noindex>
  <main class="notfound">
    <p class="eyebrow">404</p>
    <h1>This page didn't make the feed.</h1>
    <p>The link may be old or mistyped.</p>
    <a class="btn btn-primary" href={home}>Open the formatter</a>
  </main>
</Base>
